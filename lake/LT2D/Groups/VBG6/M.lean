namespace LT2D

/-- A273418 (Rule 705): %F Conjecture: a(n) = 4*4^n - 4*2^n - 7, n>1. - Lars Blomberg, Jul 19 2016 -/
theorem a273418_formula (n : Nat) (hn : 2 ≤ n) :
    (onCount 705 (2 ^ n - 1) : Int) = 4 * 4 ^ n - 4 * 2 ^ n - 7 := by
  have h := vn_count VN.VB273418.tab 705 1015 1 4 (-4) (-7) 2 2 VN.VB273418.ok2 VN.VB273418.ok1 VN.VB273418.okr n (by omega)
  first | linarith | (ring_nf at h ⊢; linarith) | (simp only [h4] at h; ring_nf at h ⊢; linarith)

/-- Rule 713 has the same count as Rule 705 at every stage 2^n - 1. -/
theorem a273418_r713_count_eq_705 (n : Nat) : onCount 713 (2 ^ n - 1) = onCount 705 (2 ^ n - 1) :=
  vn_twin_count VN.VB273418.tab 705 713 1015 VN.VB273418.ok2 VN.VB273418.ok1 (List.all_eq_true.mp VN.VB273418.twins 713 (by decide)) _

/-- A273313 (Rule 643): %F Conjecture: a(n) = 4*4^n - 4*2^n - 7, n>1. (Lars Blomberg, Jul 17 2016, read id r-mwmn9e3q-2j01ww).
Used below for Mathar's %F in A273418, a(n) = A273313(n), n>1. Same statement as LT2D.a273313_formula of group G1. -/
theorem a273418_r643_formula (n : Nat) (hn : 2 ≤ n) :
    (onCount 643 (2 ^ n - 1) : Int) = 4 * 4 ^ n - 4 * 2 ^ n - 7 := by
  have h := vn_count VN.VB273418T.tab 643 951 1 4 (-4) (-7) 2 2 VN.VB273418T.ok2 VN.VB273418T.ok1 VN.VB273418T.okr n (by omega)
  first | linarith | (ring_nf at h ⊢; linarith) | (simp only [h4] at h; ring_nf at h ⊢; linarith)

/-- A273570 (Rule 798): %F Conjecture: a(n) = 2*4^n - 6*2^n + 13, n>1. - Lars Blomberg, Jul 21 2016 -/
theorem a273570_formula (n : Nat) (hn : 2 ≤ n) :
    (onCount 798 (2 ^ n - 1) : Int) = 2 * 4 ^ n - 6 * 2 ^ n + 13 := by
