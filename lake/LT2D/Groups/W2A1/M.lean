/-- Class rule 0 (128 rules in its class): the number a(n) of ON cells inside the (2g+1)-square at stage g = 2^n - 1 satisfies a(n) = 0 for n >= 1 (computed by the generator; no OEIS text used). -/
theorem r0_count (n : Nat) (hn : 1 ≤ n) :
    (onCount 0 (2 ^ n - 1) : Int) = 0 := by
  have h := vn_count VN.WA0.tab 0 7 1 0 (0) (0) 1 1 VN.WA0.ok2 VN.WA0.ok1 VN.WA0.okr n (by omega)
  first | linarith | (ring_nf at h ⊢; linarith)

