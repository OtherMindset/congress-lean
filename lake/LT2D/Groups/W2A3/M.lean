/-- Class rule 773 (8 rules in its class): the number a(n) of ON cells inside the (2g+1)-square at stage g = 2^n - 1 satisfies a(n) = 3 * 4 ^ n - 2 * 2 ^ n for n >= 0 (computed by the generator; no OEIS text used). -/
theorem r773_count (n : Nat) :
    (onCount 773 (2 ^ n - 1) : Int) = 3 * 4 ^ n - 2 * 2 ^ n := by
  have h := vn_count VN.WA773.tab 773 935 1 3 (-2) (0) 0 1 VN.WA773.ok2 VN.WA773.ok1 VN.WA773.okr n (by omega)
  first | linarith | (ring_nf at h ⊢; linarith)

/-- Each of the other 7 rules of Rule 773's class (the list in `hR`) has the same whole-plane diagram as Rule 773 at every stage g, so the same count. -/
theorem r773_class (g : Nat) (R : Nat) (hR : R ∈ [781, 789, 797, 837, 845, 853, 861]) :
    caState R g = caState 773 g :=
  congrFun (vn_twin VN.WA773.tab 773 R 935 VN.WA773.ok2 VN.WA773.ok1 (List.all_eq_true.mp VN.WA773.twins R hR)) g

