/-- A270126 (Rule 86): %F a(n) = 3*2^(2*n-1) for n>1. - Colin Barker, Mar 21 2016 -/
theorem a270126_formula (n : Nat) (hn : 2 ≤ n) :
    (onCount 86 (2 ^ n - 1) : Int) = 3 * 2 ^ (2 * n - 1) := by
  obtain ⟨m, rfl⟩ : ∃ m, n = m + 2 := ⟨n - 2, by omega⟩
  have h := vn_count VN.VB270126.tab 86 1023 2 3 (0) (0) 2 2 VN.VB270126.ok2 VN.VB270126.ok1 VN.VB270126.okr (m + 2) (by omega)
  have e1 : 2 * (m + 2) - 1 = 2 * m + 3 := by omega
  rw [e1]
  have h4 : (4:Int) ^ (m + 2) = 2 * 2 ^ (2 * m + 3) := by
    rw [pow_add, pow_add, pow_mul]; first | ring1 | (norm_num; ring1) | norm_num
  first | linarith | (ring_nf at h ⊢; linarith) | (simp only [h4] at h; ring_nf at h ⊢; linarith)

