  simp only [Matrix.det_mul, Matrix.det_transpose, Matrix.det_diagonal] at h2
  rw [Matrix.det_of_isLowerTriangular _ Lc_lower, Matrix.det_of_isLowerTriangular _ Ql_lower, hL, hQ, hD] at h2
  revert h2
  generalize A24.det = d
  intro h2
  omega

